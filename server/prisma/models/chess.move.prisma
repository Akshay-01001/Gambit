model Move {
    id          String  @id @default(cuid())
    gameId      String
    game        Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
    chessGameId String?

    moveNumber Int
    from       String
    to         String
    san        String
    fen        String
    promotion  String

    createdAt DateTime @default(now())
}
